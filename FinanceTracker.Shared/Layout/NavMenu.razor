@using Microsoft.Extensions.Configuration

@inject IConfiguration Configuration

<div class="nav-item px-3">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
    </NavLink>
</div>

@if (!isDemoMode)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="import">
            <span class="bi bi-upload-nav-menu" aria-hidden="true"></span> Import Data
        </NavLink>
    </div>
}

<div class="nav-item px-3">
    <NavLink class="nav-link" href="transactions">
        <span class="bi bi-list-ul-nav-menu" aria-hidden="true"></span> Transactions
    </NavLink>
</div>

<div class="nav-item px-3">
    <NavLink class="nav-link" href="budgets">
        <span class="bi bi-list-ul-nav-menu" aria-hidden="true"></span> Budgets
    </NavLink>
</div>

<div class="nav-item px-3">
    <NavLink class="nav-link" href="weekly">
        <span class="bi bi-calendar-week-fill" aria-hidden="true"></span> Weekly Sprint
    </NavLink>
</div>

<div class="nav-item px-3">
    <NavLink class="nav-link" href="settings">
        <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Settings
    </NavLink>
</div>

@code {
    private bool isDemoMode;

    protected override void OnInitialized()
    {
        // Read the value as a raw string using the built-in indexer
        string demoModeString = Configuration["EnvironmentSettings:IsDemoMode"];

        // Safely parse it to a boolean
        isDemoMode = demoModeString?.Equals("true", StringComparison.OrdinalIgnoreCase) ?? false;
    }
}