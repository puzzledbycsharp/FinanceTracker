<div class="group relative inline-flex ml-2 cursor-help items-center justify-center">
    <!-- Info Icon -->
    <i class="bi bi-info-circle text-zinc-500 transition-colors duration-200 group-hover:text-cyan-400"></i>

    <!-- Tooltip Popup Container -->
    <div class="pointer-events-none invisible absolute bottom-full left-1/2 z-[1070] mb-2.5 w-max max-w-[260px] -translate-x-1/2 translate-y-1 opacity-0 transition-all duration-200 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">

        <!-- Tooltip Content Box -->
        <div class="relative rounded-lg border border-white/10 bg-zinc-800 px-3 py-2.5 text-center text-xs font-medium leading-relaxed text-zinc-200 shadow-xl shadow-black/50">
            @Text

            <!-- Little Triangle Pointer -->
            <div class="absolute -bottom-1.5 left-1/2 h-3 w-3 -translate-x-1/2 rotate-45 border-b border-r border-white/10 bg-zinc-800"></div>
        </div>

    </div>
</div>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;
}