<div class="info-tooltip-container d-inline-block ms-2">
    <i class="bi bi-info-circle text-muted info-icon"></i>
    <div class="info-tooltip-popup bg-dark text-white p-2 rounded shadow small lh-sm">
        @Text
    </div>
</div>

<style>
    .info-tooltip-container {
        position: relative;
        cursor: help;
    }

    .info-tooltip-popup {
        visibility: hidden;
        opacity: 0;
        position: absolute;
        bottom: 130%; /* Position above the icon */
        left: 50%;
        transform: translateX(-50%);
        width: max-content;
        max-width: 260px;
        text-align: center;
        z-index: 1070;
        transition: opacity 0.2s ease-in-out;
        white-space: normal;
        pointer-events: none; /* Prevents flickering if mouse moves over the tooltip itself */
    }

        /* The little triangle pointer at the bottom of the tooltip */
        .info-tooltip-popup::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #212529 transparent transparent transparent;
        }

    .info-tooltip-container:hover .info-tooltip-popup {
        visibility: visible;
        opacity: 1;
    }

    .info-icon:hover {
        color: #0d6efd !important; /* Turns blue on hover to indicate interactivity */
    }
</style>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;
}