@page "/weekly"
@using FinanceTracker.Shared.Data
@using FinanceTracker.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject FinanceDbContext DbContext

<div class="mx-auto max-w-7xl">
    <!-- Header & Navigation -->
    <div class="mb-8 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-bold tracking-tight text-white m-0">Weekly Sprint</h2>
            <p class="mt-1 text-sm font-medium text-zinc-400 m-0">@_startOfWeek.ToString("MMM d") - @_endOfWeek.ToString("MMM d")</p>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <!-- The Profile Switcher -->
            <select class="cursor-pointer rounded-lg border border-white/10 bg-zinc-900/80 px-4 py-2 text-sm font-semibold text-white shadow-xl outline-none backdrop-blur-md focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 w-full sm:w-auto" @onchange="OnProfileChanged">
                <option value="0">All Profiles (Combined)</option>
                @foreach (var profile in _profiles)
                {
                    <option value="@profile.Id">@profile.Name</option>
                }
            </select>

            <!-- Date Navigation -->
            <div class="flex items-center rounded-lg border border-white/10 bg-zinc-900/80 p-1 shadow-xl backdrop-blur-md w-full sm:w-auto justify-between sm:justify-start">
                <button class="rounded-md px-3 py-1.5 text-zinc-400 transition-colors hover:bg-white/10 hover:text-white" @onclick="GoToPreviousWeek" aria-label="Previous Week">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button class="rounded-md px-4 py-1.5 text-sm font-bold text-white transition-colors hover:bg-white/10" @onclick="GoToCurrentWeek">
                    This Week
                </button>
                <button class="rounded-md px-3 py-1.5 text-zinc-400 transition-colors hover:bg-white/10 hover:text-white" @onclick="GoToNextWeek" aria-label="Next Week">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center p-12">
            <div class="h-8 w-8 animate-spin rounded-full border-b-2 border-t-2 border-cyan-500"></div>
        </div>
    }
    else
    {
        <!-- Top Sprint Metrics -->
        <div class="mb-8 grid gap-6 md:grid-cols-2">

            @{
                bool isOverBudget = _weeklyTotal > _activeBudgetLimit;
                string cardBorder = isOverBudget ? "border-rose-500/30" : "border-cyan-500/30";
                string cardBg = isOverBudget ? "bg-rose-500/5" : "bg-cyan-500/5";
                string glowColor = isOverBudget ? "bg-rose-500/10" : "bg-cyan-500/10";
                string textColor = isOverBudget ? "text-rose-400" : "text-white";
                string iconColor = isOverBudget ? "text-rose-500" : "text-cyan-500";
            }

            <!-- Hero Discretionary Spend Card -->
            <div class="relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border @cardBorder @cardBg p-8 shadow-2xl backdrop-blur-md transition-colors duration-500">
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="h-48 w-48 rounded-full @glowColor blur-3xl"></div>
                </div>

                <div class="relative z-10 flex flex-col items-center text-center">
                    <div class="mb-3 flex items-center justify-center gap-2">
                        <h6 class="text-xs font-bold uppercase tracking-widest text-zinc-400 m-0">Discretionary Spend</h6>
                        <FinanceTracker.Shared.Components.InfoTooltip Text="Calculates total expenses for the 7-day window, strictly excluding any category marked as 'Is Fixed Bill'." />
                    </div>

                    <h1 class="text-5xl lg:text-6xl font-black tracking-tight @textColor m-0 drop-shadow-md">
                        @_weeklyTotal.ToString("C")
                    </h1>

                    <!-- Budget Pacing Tracker -->
                    <div class="mt-6 flex items-center gap-3 rounded-full border border-white/10 bg-black/40 px-5 py-2 text-sm backdrop-blur-md shadow-inner">
                        <span class="font-semibold text-zinc-300">Budget: @_activeBudgetLimit.ToString("C")</span>
                        <span class="text-zinc-600">|</span>
                        <span class="font-bold @(isOverBudget ? "text-rose-400" : "text-cyan-400")">
                            @(_activeBudgetLimit - _weeklyTotal >= 0 ? $"{(_activeBudgetLimit - _weeklyTotal):C} Remaining" : $"{Math.Abs(_activeBudgetLimit - _weeklyTotal):C} Over")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Daily Burn Rate Chart -->
            <div class="flex flex-col justify-between rounded-2xl border border-white/5 bg-zinc-900/50 p-6 shadow-2xl backdrop-blur-md">
                <div class="mb-6 flex items-center justify-between">
                    <h6 class="text-sm font-bold uppercase tracking-wider text-zinc-400 m-0">Daily Burn Rate</h6>
                    <FinanceTracker.Shared.Components.InfoTooltip Text="A day-by-day breakdown of discretionary swipes. The blue bar indicates today." />
                </div>

                <div class="flex h-[140px] items-end justify-between border-b border-white/5 pb-2">
                    @foreach (var day in _dailySpends)
                    {
                        int barHeight = _maxDailySpend > 0 ? (int)Math.Round((day.Amount / _maxDailySpend) * 100) : 0;
                        var isToday = day.Date.Date == DateTime.Today;

                        <div class="group relative flex h-full w-full flex-col items-center justify-end px-1" title="@day.Amount.ToString("C")">
                            <!-- Tooltip on hover -->
                            <div class="absolute -top-8 hidden rounded bg-zinc-800 px-2 py-1 text-xs font-bold text-white shadow-lg group-hover:block">
                                @day.Amount.ToString("C0")
                            </div>

                            <div class="@(isToday ? "bg-gradient-to-t from-cyan-600 to-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.3)]" : "bg-zinc-800 hover:bg-zinc-700") w-full rounded-t-md transition-all duration-300"
                                 style="height: @(barHeight)%; min-height: 4px;">
                            </div>
                            <small class="mt-3 text-[10px] font-bold uppercase tracking-wider @(isToday ? "text-cyan-400" : "text-zinc-500")">
                                @day.DayName
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Simplified Transaction List -->
        <div class="overflow-hidden rounded-2xl border border-white/5 bg-zinc-900/50 shadow-2xl backdrop-blur-md">
            <div class="border-b border-white/5 px-6 py-5">
                <h5 class="text-lg font-bold text-white m-0">This Week's Swipes</h5>
            </div>

            <div>
                @if (!_weeklyTransactions.Any())
                {
                    <div class="flex flex-col items-center justify-center p-12 text-center">
                        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full border border-white/5 bg-zinc-800/50">
                            <i class="bi bi-emoji-smile text-2xl text-zinc-500"></i>
                        </div>
                        <p class="text-base font-medium text-zinc-300 m-0">No discretionary spending this week yet!</p>
                        <p class="text-sm text-zinc-500 mt-1">You're doing great. Keep it up.</p>
                    </div>
                }
                else
                {
                    <div class="flex flex-col divide-y divide-white/5">
                        @foreach (var txn in _weeklyTransactions.OrderByDescending(t => t.Date))
                        {
                            <div class="group flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-6 py-4 transition-colors hover:bg-white/5">

                                <!-- Left side: Date & Description -->
                                <div class="flex items-center gap-4">
                                    <div class="flex flex-col items-center justify-center rounded-lg border border-white/10 bg-zinc-950 h-12 w-12 shadow-inner shrink-0">
                                        <span class="text-[9px] font-bold uppercase tracking-wider text-zinc-500 leading-none mb-1">@txn.Date.ToString("MMM")</span>
                                        <span class="text-base font-bold text-white leading-none">@txn.Date.ToString("dd")</span>
                                    </div>
                                    <div>
                                        <strong class="block text-sm font-medium text-zinc-200">@txn.CleanedDescription</strong>

                                        <!-- Inline Category Select -->
                                        <div class="mt-1 flex items-center">
                                            <i class="bi bi-tag-fill text-zinc-600 mr-1.5 text-xs"></i>
                                            <select class="cursor-pointer appearance-none bg-transparent py-0.5 pr-4 text-xs font-medium text-zinc-500 outline-none transition-colors hover:text-cyan-400 focus:text-cyan-400"
                                                    @onchange="@(e => UpdateCategoryAsync(txn, e))">
                                                <option value="" class="bg-zinc-900">-- Uncategorized --</option>
                                                @foreach (var cat in _categories)
                                                {
                                                    <option value="@cat" class="bg-zinc-900" selected="@(txn.Category == cat)">@cat</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right side: Amount -->
                                <div class="text-right sm:ml-auto">
                                    <span class="text-base font-bold text-white">
                                        @txn.Amount.ToString("C")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private DateTime _currentViewDate = DateTime.Today;
    private DateTime _startOfWeek;
    private DateTime _endOfWeek;

    private decimal _weeklyTotal = 0;
    private decimal _maxDailySpend = 0;

    private List<Transaction> _weeklyTransactions = new();
    private List<DailySpendInfo> _dailySpends = new();
    private List<string> _categories = new();

    // NEW: Profile state
    private List<UserProfile> _profiles = new();
    private int _selectedProfileId = 0;
    private decimal _activeBudgetLimit = 0;

    private class DailySpendInfo
    {
        public string DayName { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal Amount { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Load categories
        _categories = await DbContext.CategoryConfigs
            .Select(c => c.Name)
            .OrderBy(n => n)
            .ToListAsync();

        // Load profiles
        _profiles = await DbContext.UserProfiles.ToListAsync();

        CalculateWeekBoundaries();
        await LoadWeeklyDataAsync();
    }

    private void CalculateWeekBoundaries()
    {
        // Force Monday as the start of the week
        int diff = (7 + (_currentViewDate.DayOfWeek - DayOfWeek.Monday)) % 7;
        _startOfWeek = _currentViewDate.AddDays(-1 * diff).Date;
        _endOfWeek = _startOfWeek.AddDays(6).Date;
    }

    private async Task OnProfileChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int profileId))
        {
            _selectedProfileId = profileId;
            await LoadWeeklyDataAsync();
        }
    }

    private async Task LoadWeeklyDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var fixedCategories = await DbContext.CategoryConfigs
            .Where(c => c.IsFixedBill)
            .Select(c => c.Name)
            .ToListAsync();

        var endBoundary = _startOfWeek.AddDays(7);

        // 1. Determine the active budget limit based on dropdown selection
        if (_selectedProfileId == 0)
        {
            // Sum of all limits
            _activeBudgetLimit = _profiles.Sum(p => p.WeeklyBudgetLimit);
        }
        else
        {
            // Individual limit
            _activeBudgetLimit = _profiles.FirstOrDefault(p => p.Id == _selectedProfileId)?.WeeklyBudgetLimit ?? 0;
        }

        // 2. Build the query as an IQueryable so we can dynamically add the Profile filter
        var query = DbContext.Transactions
                    .Where(t => t.Date >= _startOfWeek
                             && t.Date < endBoundary
                             && t.Type == "Expense"
                             && !t.IsSplit
                             && (!t.IsConflict || (t.IsConflict && t.CreatedAt <= DbContext.Transactions.First(c => c.Id == t.ConflictingTransactionId).CreatedAt))
                             && !fixedCategories.Contains(t.Category ?? ""));

        // Apply profile filter if one is selected
        if (_selectedProfileId > 0)
        {
            query = query.Where(t => t.UserProfileId == _selectedProfileId);
        }

        // Execute query
        _weeklyTransactions = await query.ToListAsync();
        _weeklyTotal = _weeklyTransactions.Sum(t => t.Amount);

        // 3. Build the chart data safely
        _dailySpends.Clear();
        for (int i = 0; i < 7; i++)
        {
            var targetDate = _startOfWeek.AddDays(i).Date;

            decimal daySum = _weeklyTransactions
                .Where(t => t.Date.Year == targetDate.Year
                         && t.Date.Month == targetDate.Month
                         && t.Date.Day == targetDate.Day)
                .Sum(t => t.Amount);

            _dailySpends.Add(new DailySpendInfo
            {
                DayName = targetDate.ToString("ddd"),
                Date = targetDate,
                Amount = daySum
            });
        }

        _maxDailySpend = _dailySpends.Any() ? _dailySpends.Max(d => d.Amount) : 0;
        if (_maxDailySpend == 0) _maxDailySpend = 1;

        _isLoading = false;
    }

    private async Task UpdateCategoryAsync(Transaction txn, ChangeEventArgs e)
    {
        var newCategory = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(newCategory) && txn.Category != newCategory)
        {
            txn.Category = newCategory;
            DbContext.Transactions.Update(txn);
            await DbContext.SaveChangesAsync();
            await LoadWeeklyDataAsync();
        }
    }

    // --- Navigation Handlers ---
    private async Task GoToPreviousWeek()
    {
        _currentViewDate = _currentViewDate.AddDays(-7);
        CalculateWeekBoundaries();
        await LoadWeeklyDataAsync();
    }

    private async Task GoToNextWeek()
    {
        _currentViewDate = _currentViewDate.AddDays(7);
        CalculateWeekBoundaries();
        await LoadWeeklyDataAsync();
    }

    private async Task GoToCurrentWeek()
    {
        _currentViewDate = DateTime.Today;
        CalculateWeekBoundaries();
        await LoadWeeklyDataAsync();
    }
}