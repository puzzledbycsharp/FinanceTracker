@page "/weekly"
@using FinanceTracker.Shared.Data
@using FinanceTracker.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject FinanceDbContext DbContext

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-0">Weekly Sprint</h2>
        <p class="text-muted mb-0">@_startOfWeek.ToString("MMM d") - @_endOfWeek.ToString("MMM d")</p>
    </div>

    <div class="d-flex align-items-center gap-3">
        <!-- The Profile Switcher -->
        <select class="form-select border-secondary fw-bold shadow-sm" style="width: auto;" @onchange="OnProfileChanged">
            <option value="0">All Profiles (Combined)</option>
            @foreach (var profile in _profiles)
            {
                <option value="@profile.Id">@profile.Name</option>
            }
        </select>

        <!-- Date Navigation -->
        <div class="btn-group shadow-sm">
            <button class="btn btn-outline-secondary" @onclick="GoToPreviousWeek"><i class="bi bi-chevron-left"></i></button>
            <button class="btn btn-outline-primary fw-bold" @onclick="GoToCurrentWeek">This Week</button>
            <button class="btn btn-outline-secondary" @onclick="GoToNextWeek"><i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <!-- Top Sprint Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-0 @(_weeklyTotal > _activeBudgetLimit ? "bg-danger" : "bg-primary") text-white" style="transition: background-color 0.3s;">
                <div class="card-body d-flex flex-column justify-content-center align-items-center py-4">
                    <div class="d-flex align-items-center justify-content-center mb-2">
                        <h6 class="text-white-50 text-uppercase fw-bold tracking-wide mb-0 me-2">Discretionary Spend</h6>
                        <FinanceTracker.Shared.Components.InfoTooltip Text="Calculates total expenses for the 7-day window, strictly excluding any category marked as 'Is Fixed Bill'." />
                    </div>
                    <h1 class="display-4 fw-bold mb-0">@_weeklyTotal.ToString("C")</h1>

                    <!-- Budget Pacing Tracker -->
                    <div class="mt-3 px-3 py-1 rounded bg-white bg-opacity-25 d-flex align-items-center gap-2">
                        <small class="fw-bold">Budget: @_activeBudgetLimit.ToString("C")</small>
                        <small>|</small>
                        <small>@(_activeBudgetLimit - _weeklyTotal >= 0 ? $"{(_activeBudgetLimit - _weeklyTotal):C} Remaining" : $"{Math.Abs(_activeBudgetLimit - _weeklyTotal):C} Over")</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-0 bg-light">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="text-muted text-uppercase fw-bold mb-0">Daily Burn Rate</h6>
                        <FinanceTracker.Shared.Components.InfoTooltip Text="A day-by-day breakdown of discretionary swipes. The blue bar indicates today." />
                    </div>

                    <div class="d-flex justify-content-between align-items-end" style="height: 120px;">
                        @foreach (var day in _dailySpends)
                        {
                            int barHeight = _maxDailySpend > 0 ? (int)Math.Round((day.Amount / _maxDailySpend) * 100) : 0;
                            var isToday = day.Date.Date == DateTime.Today;

                            <div class="d-flex flex-column align-items-center justify-content-end w-100 px-1 h-100" title="@day.Amount.ToString("C")">
                                <div class="@(isToday ? "bg-primary" : "bg-secondary opacity-50") rounded-top w-100 sprint-bar"
                                     style="height: @(barHeight)%; min-height: 4px; transition: height 0.3s ease;">
                                </div>
                                <small class="mt-2 fw-bold @(isToday ? "text-primary" : "text-muted")" style="font-size: 0.75rem;">
                                    @day.DayName
                                </small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Simplified Transaction List -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="mb-0">This Week's Swipes</h5>
        </div>
        <div class="card-body">
            @if (!_weeklyTransactions.Any())
            {
                <div class="text-center p-4 text-muted">
                    <i class="bi bi-emoji-smile fs-1 d-block mb-2"></i>
                    No discretionary spending this week yet!
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <tbody>
                            @foreach (var txn in _weeklyTransactions.OrderByDescending(t => t.Date))
                            {
                                <tr>
                                    <td style="width: 60px;">
                                        <div class="bg-light rounded text-center py-1">
                                            <small class="d-block text-muted" style="font-size: 0.7rem;">@txn.Date.ToString("MMM")</small>
                                            <strong class="d-block lh-1">@txn.Date.ToString("dd")</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <strong class="d-block text-dark">@txn.CleanedDescription</strong>
                                        <select class="form-select form-select-sm border-0 bg-transparent p-0 text-muted shadow-none inline-category-select"
                                                @onchange="@(e => UpdateCategoryAsync(txn, e))">
                                            <option value="">-- Select --</option>
                                            @foreach (var cat in _categories)
                                            {
                                                <option value="@cat" selected="@(txn.Category == cat)">@cat</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        @txn.Amount.ToString("C")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<style>
    .sprint-bar:hover {
        filter: brightness(0.8);
        cursor: pointer;
    }

    .tracking-wide {
        letter-spacing: 1px;
    }

    .inline-category-select {
        width: auto;
        display: inline-block;
        cursor: pointer;
        font-size: 0.875em;
    }

        .inline-category-select:hover {
            color: #0d6efd !important;
            text-decoration: underline;
        }
</style>

@code {
    private bool _isLoading = true;
    private DateTime _currentViewDate = DateTime.Today;
    private DateTime _startOfWeek;
    private DateTime _endOfWeek;

    private decimal _weeklyTotal = 0;
    private decimal _maxDailySpend = 0;

    private List<Transaction> _weeklyTransactions = new();
    private List<DailySpendInfo> _dailySpends = new();
    private List<string> _categories = new();

    // NEW: Profile state
    private List<UserProfile> _profiles = new();
    private int _selectedProfileId = 0;
    private decimal _activeBudgetLimit = 0;

    private class DailySpendInfo
    {
        public string DayName { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal Amount { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Load categories
        _categories = await DbContext.CategoryConfigs
            .Select(c => c.Name)
            .OrderBy(n => n)
            .ToListAsync();

        // Load profiles
        _profiles = await DbContext.UserProfiles.ToListAsync();

        CalculateWeekBoundaries();
        await LoadWeeklyDataAsync();
    }

    private void CalculateWeekBoundaries()
    {
        // Force Monday as the start of the week
        int diff = (7 + (_currentViewDate.DayOfWeek - DayOfWeek.Monday)) % 7;
        _startOfWeek = _currentViewDate.AddDays(-1 * diff).Date;
        _endOfWeek = _startOfWeek.AddDays(6).Date;
    }

    private async Task OnProfileChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int profileId))
        {
            _selectedProfileId = profileId;
            await LoadWeeklyDataAsync();
        }
    }

    private async Task LoadWeeklyDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var fixedCategories = await DbContext.CategoryConfigs
            .Where(c => c.IsFixedBill)
            .Select(c => c.Name)
            .ToListAsync();

        var endBoundary = _startOfWeek.AddDays(7);

        // 1. Determine the active budget limit based on dropdown selection
        if (_selectedProfileId == 0)
        {
            // Sum of all limits
            _activeBudgetLimit = _profiles.Sum(p => p.WeeklyBudgetLimit);
        }
        else
        {
            // Individual limit
            _activeBudgetLimit = _profiles.FirstOrDefault(p => p.Id == _selectedProfileId)?.WeeklyBudgetLimit ?? 0;
        }

        // 2. Build the query as an IQueryable so we can dynamically add the Profile filter
        var query = DbContext.Transactions
                    .Where(t => t.Date >= _startOfWeek
                             && t.Date < endBoundary
                             && t.Type == "Expense"
                             && !t.IsSplit
                             && (!t.IsConflict || (t.IsConflict && t.CreatedAt <= DbContext.Transactions.First(c => c.Id == t.ConflictingTransactionId).CreatedAt))
                             && !fixedCategories.Contains(t.Category ?? ""));

        // Apply profile filter if one is selected
        if (_selectedProfileId > 0)
        {
            query = query.Where(t => t.UserProfileId == _selectedProfileId);
        }

        // Execute query
        _weeklyTransactions = await query.ToListAsync();
        _weeklyTotal = _weeklyTransactions.Sum(t => t.Amount);

        // 3. Build the chart data safely
        _dailySpends.Clear();
        for (int i = 0; i < 7; i++)
        {
            var targetDate = _startOfWeek.AddDays(i).Date;

            decimal daySum = _weeklyTransactions
                .Where(t => t.Date.Year == targetDate.Year
                         && t.Date.Month == targetDate.Month
                         && t.Date.Day == targetDate.Day)
                .Sum(t => t.Amount);

            _dailySpends.Add(new DailySpendInfo
            {
                DayName = targetDate.ToString("ddd"),
                Date = targetDate,
                Amount = daySum
            });
        }

        _maxDailySpend = _dailySpends.Any() ? _dailySpends.Max(d => d.Amount) : 0;
        if (_maxDailySpend == 0) _maxDailySpend = 1;

        _isLoading = false;
    }

    private async Task UpdateCategoryAsync(Transaction txn, ChangeEventArgs e)
    {
        var newCategory = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(newCategory) && txn.Category != newCategory)
        {
            txn.Category = newCategory;
            DbContext.Transactions.Update(txn);
            await DbContext.SaveChangesAsync();
            await LoadWeeklyDataAsync();
        }
    }

    // --- Navigation Handlers ---
    private async Task GoToPreviousWeek()
    {
        _currentViewDate = _currentViewDate.AddDays(-7);
        CalculateWeekBoundaries();
        await LoadWeeklyDataAsync();
    }

    private async Task GoToNextWeek()
    {
        _currentViewDate = _currentViewDate.AddDays(7);
        CalculateWeekBoundaries();
        await LoadWeeklyDataAsync();
    }

    private async Task GoToCurrentWeek()
    {
        _currentViewDate = DateTime.Today;
        CalculateWeekBoundaries();
        await LoadWeeklyDataAsync();
    }
}