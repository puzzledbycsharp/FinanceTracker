@page "/transactions"
@rendermode InteractiveServer
@using FinanceTracker.Shared.Models
@using FinanceTracker.Shared.Data
@using FinanceTracker.Shared.Services
@using Microsoft.EntityFrameworkCore
@inject TransactionStateService TxStateService
@inject FinanceDbContext DbContext
@inject CategoryMemoryService MemoryService
@inject NavigationManager Navigation
@implements IDisposable

<div class="mx-auto max-w-7xl">
    <!-- Header & Actions -->
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-white">Transaction Manager</h2>
        <div class="flex items-center gap-3">
            @if (!string.IsNullOrEmpty(Category) || !string.IsNullOrEmpty(Period) || !string.IsNullOrEmpty(Type) || Week.HasValue)
            {
                <button class="flex items-center gap-2 rounded-lg border border-rose-500/30 bg-rose-500/10 px-4 py-2 text-sm font-medium text-rose-400 transition-colors hover:bg-rose-500/20" @onclick="ClearFilters">
                    <i class="bi bi-x-circle"></i> Clear Filters
                </button>
            }
            <button class="flex items-center gap-2 rounded-lg border border-white/10 bg-zinc-900/80 px-4 py-2 text-sm font-medium text-white shadow-xl backdrop-blur-md transition-colors hover:border-cyan-500/50 hover:bg-zinc-800" @onclick="ForceRefreshAsync">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center p-12">
            <div class="h-8 w-8 animate-spin rounded-full border-b-2 border-t-2 border-cyan-500"></div>
        </div>
    }
    else if (!_transactions.Any())
    {
        <div class="rounded-2xl border border-white/5 bg-zinc-900/50 p-12 text-center shadow-2xl backdrop-blur-md">
            <i class="bi bi-inbox text-4xl text-zinc-600 mb-4 block"></i>
            <p class="m-0 text-lg font-medium text-zinc-400">No transactions found. Go import some data!</p>
        </div>
    }
    else
    {
        <!-- Premium Glassmorphic Data Grid -->
        <div class="mb-12 overflow-hidden rounded-2xl border border-white/5 bg-zinc-900/50 shadow-2xl backdrop-blur-md">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-zinc-300">
                    <thead class="border-b border-white/10 bg-zinc-950/50 text-xs font-semibold uppercase tracking-wider text-zinc-400">
                        <tr>
                            <th class="px-6 py-4">Date</th>
                            <th class="px-6 py-4">Account</th>
                            <th class="px-6 py-4">Description</th>
                            <th class="px-6 py-4">Amount</th>
                            <th class="px-6 py-4">Category</th>
                            <th class="px-6 py-4 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <!-- We now iterate over _pagedTransactions instead of all transactions -->
                        @foreach (var txn in _pagedTransactions)
                        {
                            var isParent = txn.IsSplit;
                            var isChild = txn.ParentTransactionId != null;
                            var rowClass = isParent ? "bg-zinc-950/40 text-zinc-500" : (isChild ? "bg-white/[0.02]" : "transition-colors hover:bg-white/5");

                            <tr class="@rowClass">
                                <td class="whitespace-nowrap px-6 py-4 font-medium @(isParent ? "text-zinc-600" : "text-zinc-400")">
                                    @txn.Date.ToShortDateString()
                                </td>

                                <td class="px-6 py-4">
                                    <span class="rounded-full border border-white/10 bg-zinc-950 px-2.5 py-1 text-xs font-semibold tracking-wide text-zinc-400 shadow-inner">
                                        @txn.Account
                                    </span>
                                </td>

                                <td class="px-6 py-4 @(isChild ? "pl-12" : "")">
                                    <div class="flex items-center gap-2">
                                        @if (isChild)
                                        {
                                            <i class="bi bi-arrow-return-right text-cyan-500/50"></i>
                                        }
                                        <span title="@txn.OriginalDescription" class="@(isParent ? "text-zinc-500" : "text-zinc-200")">
                                            @(isParent ? $"[SPLIT] {txn.CleanedDescription}" : txn.CleanedDescription)
                                        </span>
                                    </div>
                                </td>

                                <td class="whitespace-nowrap px-6 py-4 font-semibold @(isParent ? "line-through text-zinc-600" : "text-white")">
                                    @txn.Amount.ToString("C")
                                </td>

                                <td class="w-48 px-6 py-4">
                                    @if (txn.IsSplit)
                                    {
                                        <span class="text-xs font-medium italic text-zinc-600">Split into multiple</span>
                                    }
                                    else
                                    {
                                        <select class="w-full cursor-pointer rounded-lg border border-white/10 bg-zinc-950 px-3 py-1.5 text-sm text-zinc-300 shadow-inner outline-none transition-all focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                                                value="@txn.Category"
                                                @onchange="@(e => UpdateCategoryAsync(txn, e.Value?.ToString()))">
                                            <option value="">Uncategorized</option>
                                            @foreach (var cat in _availableCategories)
                                            {
                                                <option value="@cat">@cat</option>
                                            }
                                        </select>
                                    }
                                </td>

                                <td class="px-6 py-4 text-center">
                                    @if (!txn.IsSplit && txn.ParentTransactionId == null && txn.Type == "Expense")
                                    {
                                        <button class="mx-auto flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-zinc-800 text-zinc-400 transition-colors hover:border-cyan-500/50 hover:bg-cyan-500/10 hover:text-cyan-400"
                                                @onclick="() => OpenSplitModal(txn)"
                                                title="Split Transaction">
                                            <i class="bi bi-scissors"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Footer -->
            <div class="flex flex-col items-center justify-between border-t border-white/10 bg-zinc-950/30 px-6 py-4 sm:flex-row">
                <div class="mb-4 flex items-center gap-3 sm:mb-0">
                    <span class="text-sm font-medium text-zinc-400">Rows per page:</span>
                    <select class="cursor-pointer rounded-lg border border-white/10 bg-zinc-900 px-2 py-1 text-sm text-white shadow-inner outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" @onchange="OnPageSizeChanged">
                        @foreach (var size in _pageSizeOptions)
                        {
                            <option value="@size" selected="@(size == _pageSize)">@size</option>
                        }
                    </select>
                    <span class="ml-4 text-sm font-medium text-zinc-500">
                        Showing @((_currentPage - 1) * _pageSize + 1) to @(Math.Min(_currentPage * _pageSize, _transactions.Count)) of @_transactions.Count
                    </span>
                </div>

                <div class="flex items-center gap-2">
                    <button class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-zinc-800 text-zinc-400 transition-colors hover:bg-zinc-700 hover:text-white disabled:pointer-events-none disabled:opacity-50"
                            @onclick="() => OnPageChanged(_currentPage - 1)"
                            disabled="@(_currentPage <= 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="px-4 text-sm font-medium text-white">
                        Page @_currentPage of @TotalPages
                    </span>
                    <button class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-zinc-800 text-zinc-400 transition-colors hover:bg-zinc-700 hover:text-white disabled:pointer-events-none disabled:opacity-50"
                            @onclick="() => OnPageChanged(_currentPage + 1)"
                            disabled="@(_currentPage >= TotalPages || TotalPages == 0)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

        </div>
    }
</div>

<!-- SPLIT MODAL OVERLAY -->
@if (_showSplitModal && _transactionToSplit != null)
{
    <div class="fixed inset-0 z-[1050] flex items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
        <div class="w-full max-w-3xl overflow-hidden rounded-2xl border border-white/10 bg-zinc-900 shadow-2xl">

            <div class="flex items-center justify-between border-b border-white/10 bg-zinc-950/50 px-6 py-4">
                <h5 class="m-0 text-lg font-bold text-white">Split Transaction</h5>
                <button type="button" class="text-zinc-400 transition-colors hover:text-white" @onclick="CloseSplitModal">
                    <i class="bi bi-x-lg text-xl"></i>
                </button>
            </div>

            <div class="p-6">
                <div class="mb-6 flex items-center justify-between rounded-xl border border-white/5 bg-zinc-800/50 p-4 shadow-inner">
                    <div>
                        <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-zinc-500">Original Transaction</div>
                        <div class="text-base font-medium text-white">@_transactionToSplit.CleanedDescription</div>
                        <div class="mt-1 text-sm text-zinc-400"><i class="bi bi-credit-card mr-1"></i> @_transactionToSplit.Account</div>
                    </div>
                    <div class="text-right">
                        <strong class="text-2xl font-bold text-white">@_transactionToSplit.Amount.ToString("C")</strong>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="mb-4 w-full text-left text-sm text-zinc-300">
                        <thead class="border-b border-white/10 text-xs font-semibold uppercase tracking-wider text-zinc-500">
                            <tr>
                                <th class="pb-3 pr-4">Category</th>
                                <th class="w-32 px-4 pb-3">Amount ($)</th>
                                <th class="px-4 pb-3">Note (Optional)</th>
                                <th class="pb-3 pl-4 text-center"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @foreach (var split in _splitItems)
                            {
                                <tr>
                                    <td class="py-3 pr-4">
                                        <select class="w-full rounded-lg border border-white/10 bg-zinc-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" @bind="split.Category">
                                            <option value="">Select...</option>
                                            @foreach (var cat in _availableCategories)
                                            {
                                                <option value="@cat">@cat</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="px-4 py-3">
                                        <input type="number" class="w-full rounded-lg border border-white/10 bg-zinc-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" @bind="split.Amount" step="0.01" />
                                    </td>
                                    <td class="px-4 py-3">
                                        <input type="text" class="w-full rounded-lg border border-white/10 bg-zinc-950 px-3 py-2 text-sm text-white placeholder-zinc-600 outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" @bind="split.Description" placeholder="e.g., Groceries" />
                                    </td>
                                    <td class="pl-4 py-3 text-center">
                                        <button class="mx-auto flex h-8 w-8 items-center justify-center rounded-lg border border-transparent text-zinc-500 transition-colors hover:border-rose-500/30 hover:bg-rose-500/10 hover:text-rose-400" @onclick="() => _splitItems.Remove(split)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button class="flex items-center gap-2 text-sm font-semibold text-cyan-400 transition-colors hover:text-cyan-300" @onclick="AddSplitRow">
                    <i class="bi bi-plus-circle-fill"></i> Add Split Row
                </button>

                <div class="mt-8 flex flex-col items-center justify-between border-t border-white/10 pt-6 sm:flex-row">
                    @{
                        decimal totalSplit = _splitItems.Sum(s => s.Amount);
                        decimal remaining = _transactionToSplit.Amount - totalSplit;
                    }
                    <div class="mb-4 flex items-center gap-3 sm:mb-0">
                        <span class="text-sm font-medium text-zinc-400">Remaining to assign:</span>
                        <span class="rounded-lg border px-3 py-1 text-lg font-bold @(remaining == 0 ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-400" : "border-rose-500/30 bg-rose-500/10 text-rose-400")">
                            @remaining.ToString("C")
                        </span>
                    </div>

                    <div class="flex w-full gap-3 sm:w-auto">
                        <button class="flex-1 rounded-lg border border-white/10 bg-zinc-800 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 sm:flex-none" @onclick="CloseSplitModal">Cancel</button>

                        <button class="flex-1 rounded-lg bg-gradient-to-r from-emerald-500 to-emerald-400 px-6 py-2.5 text-sm font-bold text-zinc-950 transition-all hover:scale-105 disabled:scale-100 disabled:opacity-50 disabled:grayscale sm:flex-none"
                                @onclick="SaveSplitAsync"
                                disabled="@(remaining != 0 || _splitItems.Any(s => string.IsNullOrEmpty(s.Category)))">
                            Save Splits
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? Category { get; set; }
    [SupplyParameterFromQuery] public string? Period { get; set; }
    [SupplyParameterFromQuery] public string? Type { get; set; }
    [SupplyParameterFromQuery] public int? Week { get; set; }
    [SupplyParameterFromQuery] public decimal? MaxAmount { get; set; }

    private bool _isLoading = true;
    private List<Transaction> _transactions = new(); // The fully filtered list
    private List<Transaction> _pagedTransactions = new(); // The current page being shown
    private List<string> _availableCategories = new();

    // Pagination State
    private int _currentPage = 1;
    private int _pageSize = 25;
    private List<int> _pageSizeOptions = new() { 10, 25, 50, 100 };
    private int TotalPages => (int)Math.Ceiling((double)_transactions.Count / _pageSize);

    // Modal State
    private bool _showSplitModal = false;
    private Transaction? _transactionToSplit;
    private List<SplitItem> _splitItems = new();

    private class SplitItem
    {
        public decimal Amount { get; set; }
        public string Category { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        // 1. Immediately paint the screen
        _isLoading = true;
        TxStateService.OnStateChanged += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 2. Fetch categories and transactions in the background
            _availableCategories = await DbContext.CategoryConfigs.Select(c => c.Name).OrderBy(n => n).ToListAsync();
            await LoadTransactionsAsync();
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Prevent double loading on first render
        if (!_isLoading)
        {
            await LoadTransactionsAsync();
        }
    }

    private async Task LoadTransactionsAsync()
    {
        _isLoading = true;

        // Pull instantly from the State Service Gatekeeper
        var allTxns = await TxStateService.GetTransactionsAsync();
        var query = allTxns.AsEnumerable();

        if (!string.IsNullOrEmpty(Period))
        {
            var parts = Period.Split('-');
            if (parts.Length == 2 && int.TryParse(parts[0], out int year) && int.TryParse(parts[1], out int month))
            {
                query = query.Where(t => t.Date.Year == year && t.Date.Month == month);
                if (Week.HasValue)
                {
                    int startDay = (Week.Value - 1) * 7 + 1;
                    int endDay = Math.Min(Week.Value * 7, DateTime.DaysInMonth(year, month));
                    query = query.Where(t => t.Date.Day >= startDay && t.Date.Day <= endDay);
                }
            }
        }

        if (!string.IsNullOrEmpty(Type))
        {
            query = query.Where(t => t.Type == Type);
        }

        if (!string.IsNullOrEmpty(Category))
        {
            query = Category == "Uncategorized"
                ? query.Where(t => string.IsNullOrEmpty(t.Category) || t.Category == "Uncategorized")
                : query.Where(t => t.Category == Category);
        }

        if (MaxAmount.HasValue)
        {
            query = query.Where(t => t.Amount <= MaxAmount.Value);
        }

        _transactions = query.ToList();

        // Reset to page 1 whenever filters change, then apply pagination
        _currentPage = 1;
        UpdatePagedTransactions();

        _isLoading = false;
    }

    // --- Pagination Logic ---
    private void UpdatePagedTransactions()
    {
        if (_currentPage > TotalPages && TotalPages > 0) _currentPage = TotalPages;

        _pagedTransactions = _transactions
                    .Skip((_currentPage - 1) * _pageSize)
                    .Take(_pageSize)
                    .ToList();
    }

    private void OnPageChanged(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            _currentPage = newPage;
            UpdatePagedTransactions();
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            _pageSize = newSize;
            _currentPage = 1; // Return to first page when changing page size
            UpdatePagedTransactions();
        }
    }

    // --- State Reactive Methods ---
    private void HandleStateChanged()
    {
        // When data updates elsewhere, silently reload local view without spinning
        InvokeAsync(async () =>
        {
            await LoadTransactionsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TxStateService.OnStateChanged -= HandleStateChanged;
    }

    private async Task ForceRefreshAsync()
    {
        _isLoading = true;
        await TxStateService.ForceRefreshAsync();
        // HandleStateChanged will naturally fire and remove the spinner
    }

    private void ClearFilters() => Navigation.NavigateTo("/transactions");

    private async Task UpdateCategoryAsync(Transaction txn, string? newCategory)
    {
        if (string.IsNullOrWhiteSpace(newCategory)) return;

        // Push the update strictly through the centralized state service
        await TxStateService.UpdateCategoryAsync(txn, newCategory);
        await MemoryService.LearnCategoryAsync(txn.CleanedDescription, newCategory);
    }

    // --- Split Modal Logic ---
    private void OpenSplitModal(Transaction txn)
    {
        _transactionToSplit = txn;
        _splitItems.Clear();
        _splitItems.Add(new SplitItem());
        _splitItems.Add(new SplitItem());
        _showSplitModal = true;
    }

    private void CloseSplitModal()
    {
        _showSplitModal = false;
        _transactionToSplit = null;
    }

    private void AddSplitRow() => _splitItems.Add(new SplitItem());

    private async Task SaveSplitAsync()
    {
        if (_transactionToSplit == null) return;

        var children = new List<Transaction>();
        foreach (var split in _splitItems)
        {
            children.Add(new Transaction
            {
                Id = Guid.NewGuid(),
                Account = _transactionToSplit.Account,
                Date = _transactionToSplit.Date,
                Type = _transactionToSplit.Type,
                Amount = split.Amount,
                Category = split.Category,
                UniqueHash = $"{_transactionToSplit.UniqueHash}-split-{Guid.NewGuid().ToString().Substring(0, 8)}",
                OriginalDescription = _transactionToSplit.OriginalDescription,
                CleanedDescription = string.IsNullOrWhiteSpace(split.Description)
                    ? _transactionToSplit.CleanedDescription
                    : $"{_transactionToSplit.CleanedDescription} ({split.Description})",
                ParentTransactionId = _transactionToSplit.Id
            });
            await MemoryService.LearnCategoryAsync(children.Last().CleanedDescription, split.Category);
        }

        // Push everything through the centralized gatekeeper
        await TxStateService.AddSplitTransactionsAsync(_transactionToSplit, children);
        CloseSplitModal();
    }
}