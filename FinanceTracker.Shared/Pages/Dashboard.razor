@page "/"
@using FinanceTracker.Shared.Data
@using FinanceTracker.Shared.Models
@using FinanceTracker.Shared.Services
@using Microsoft.EntityFrameworkCore
@inject FinanceDbContext DbContext
@inject NavigationManager Navigation
@inject FinancialInsightService InsightService
@inject FinanceTracker.Shared.Services.GamificationEngineService GamificationEngine
@inject TransactionStateService TxStateService
@implements IDisposable

<div class="mx-auto max-w-7xl">
    <!-- Dashboard Header -->
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
            <h2 class="text-2xl font-bold tracking-tight text-white">Financial Dashboard</h2>
            @if (_totalPoints > 0)
            {
                <span class="flex items-center rounded-full border border-yellow-500/30 bg-yellow-500/10 px-3 py-1 text-sm font-medium text-yellow-400 backdrop-blur-md shadow-lg shadow-yellow-500/5">
                    <i class="bi bi-star-fill mr-1.5"></i> @_totalPoints
                </span>
            }
        </div>

        @if (_availablePeriods.Any())
        {
            <div class="flex items-center gap-3">
                <label for="monthSelect" class="text-sm font-medium text-zinc-400">Period:</label>
                <select id="monthSelect" class="cursor-pointer rounded-lg border border-white/10 bg-zinc-900/80 px-4 py-2 text-sm text-white shadow-xl outline-none backdrop-blur-md focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" @onchange="OnPeriodChanged">
                    @foreach (var period in _availablePeriods)
                    {
                        <option value="@period.Value" selected="@(period.Value == _selectedPeriod)">
                            @period.Label
                        </option>
                    }
                </select>
            </div>
        }
    </div>

    <!-- Premium FinTech Summary Cards -->
    <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <!-- Total Income -->
        <div class="flex flex-col justify-between rounded-2xl border border-white/5 bg-zinc-900/50 p-6 shadow-2xl backdrop-blur-md relative min-h-[120px]">
            @if (_isLoading)
            {
                <div class="absolute inset-0 flex items-center justify-center bg-zinc-950/40 backdrop-blur-xs rounded-2xl"><div class="h-5 w-5 animate-spin rounded-full border-b-2 border-cyan-400"></div></div>
            }
            <h6 class="text-sm font-medium text-zinc-400">Total Income</h6>
            <div class="mt-4 text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-500">
                @_monthlyIncome.ToString("C")
            </div>
        </div>

        <!-- Expected Bills -->
        <div class="flex flex-col justify-between rounded-2xl border border-white/5 bg-zinc-900/50 p-6 shadow-2xl backdrop-blur-md relative min-h-[120px]">
            <!-- Isolate the overflow-hidden to just the background glow -->
            <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl">
                <div class="absolute -right-4 -top-4 h-24 w-24 rounded-full bg-white/5 blur-2xl"></div>
            </div>

            @if (_isLoading)
            {
                <div class="absolute inset-0 z-20 flex items-center justify-center rounded-2xl bg-zinc-950/40 backdrop-blur-xs"><div class="h-5 w-5 animate-spin rounded-full border-b-2 border-cyan-400"></div></div>
            }

            <div class="relative z-10 flex items-center justify-between">
                <h6 class="text-sm font-medium text-zinc-400">Expected Bills</h6>
                <FinanceTracker.Shared.Components.InfoTooltip Text="Estimated fixed bills (based on your 2-month average) that haven't hit your account yet this month." />
            </div>
            <div class="relative z-10">
                <div class="mt-4 text-3xl font-bold text-zinc-300">
                    @_remainingExpectedBills.ToString("C")
                </div>
                <p class="mt-1 text-xs text-zinc-500">@_paidFixedBills.ToString("C") paid so far</p>
            </div>
        </div>

        <!-- Total Expenses -->
        <div class="flex flex-col justify-between rounded-2xl border border-white/5 bg-zinc-900/50 p-6 shadow-2xl backdrop-blur-md relative min-h-[120px]">
            @if (_isLoading)
            {
                <div class="absolute inset-0 flex items-center justify-center bg-zinc-950/40 backdrop-blur-xs rounded-2xl"><div class="h-5 w-5 animate-spin rounded-full border-b-2 border-cyan-400"></div></div>
            }
            <h6 class="text-sm font-medium text-zinc-400">Total Expenses</h6>
            <div class="mt-4 text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-fuchsia-500">
                @_monthlyExpenses.ToString("C")
            </div>
        </div>

        <!-- Safe to Spend (Dynamic Colors) -->
        <div class="flex flex-col justify-between rounded-2xl border @(_safeToSpend >= 0 ? "border-cyan-500/30 bg-cyan-500/5" : "border-rose-500/30 bg-rose-500/5") p-6 shadow-2xl backdrop-blur-md relative min-h-[120px]">
            <!-- Isolate the overflow-hidden to just the background glow -->
            <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl">
                <div class="absolute -right-4 -top-4 h-24 w-24 rounded-full @(_safeToSpend >= 0 ? "bg-cyan-500/10" : "bg-rose-500/10") blur-2xl"></div>
            </div>

            @if (_isLoading)
            {
                <div class="absolute inset-0 z-20 flex items-center justify-center rounded-2xl bg-zinc-950/40 backdrop-blur-xs"><div class="h-5 w-5 animate-spin rounded-full border-b-2 border-cyan-400"></div></div>
            }

            <div class="relative z-10 flex items-center justify-between">
                <h6 class="text-sm font-medium @(_safeToSpend >= 0 ? "text-cyan-400" : "text-rose-400")">Safe to Spend</h6>
                <FinanceTracker.Shared.Components.InfoTooltip Text="Your total income minus everything you've already spent, minus your remaining expected fixed bills." />
            </div>
            <div class="relative z-10">
                <div class="mt-4 text-3xl font-bold @(_safeToSpend >= 0 ? "text-white" : "text-rose-400")">
                    @_safeToSpend.ToString("C")
                </div>
                <p class="mt-1 text-xs @(_safeToSpend >= 0 ? "text-cyan-500/70" : "text-rose-500/70")">True leftover cash flow</p>
            </div>
        </div>
    </div>

    <!-- 3-Item Flex Carousel for Insights -->
    @if (_insights.Any())
    {
        <div class="mb-8 rounded-2xl border border-white/5 bg-zinc-900/50 shadow-2xl backdrop-blur-md">
            <div class="flex items-center justify-between border-b border-white/5 px-6 py-4">
                <h5 class="flex items-center text-lg font-bold text-white m-0">
                    <i class="bi bi-lightbulb-fill text-yellow-400 mr-2.5"></i> Trend Insights
                </h5>

                <!-- Carousel Controls -->
                <div class="flex items-center gap-4">
                    <button class="flex h-8 w-8 items-center justify-center rounded-full bg-zinc-800 text-zinc-400 hover:bg-zinc-700 hover:text-white transition-colors" @onclick="PreviousInsight" aria-label="Previous Insight">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="text-sm font-medium text-zinc-500">@(_currentInsightIndex + 1) of @_insights.Count</span>
                    <button class="flex h-8 w-8 items-center justify-center rounded-full bg-zinc-800 text-zinc-400 hover:bg-zinc-700 hover:text-white transition-colors" @onclick="NextInsight" aria-label="Next Insight">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="p-6">
                <div @key="_currentInsightIndex" class="insight-slide flex flex-col md:flex-row gap-4 justify-center items-stretch w-full">
                    @for (int i = 0; i < Math.Min(3, _insights.Count); i++)
                    {
                        var index = (_currentInsightIndex + i) % _insights.Count;
                        var currentInsight = _insights[index];
                        var targetUrl = currentInsight.Category == "Discretionary"
                            ? $"/transactions?period={_selectedPeriod}&type=Expense&maxamount=20"
                            : $"/transactions?period={_selectedPeriod}&category={Uri.EscapeDataString(currentInsight.Category)}";

                        var isAlert = currentInsight.Severity == InsightSeverity.Alert;
                        var cardClasses = isAlert
                            ? "border-rose-500/20 bg-rose-500/5 hover:bg-rose-500/10"
                            : "border-yellow-500/20 bg-yellow-500/5 hover:bg-yellow-500/10";
                        var iconClasses = isAlert ? "text-rose-400" : "text-yellow-400";

                        <div class="flex-1 w-full">
                            <a href="@targetUrl" class="block h-full card-hover text-decoration-none">
                                <div class="flex h-full flex-col items-center justify-start rounded-xl border p-5 text-center transition-colors @cardClasses">
                                    <div class="mb-3 flex items-center justify-center gap-2">
                                        <i class="bi @currentInsight.Icon text-xl @iconClasses"></i>
                                        <h5 class="text-sm font-bold text-white m-0">@currentInsight.Title</h5>
                                    </div>
                                    <p class="mb-4 text-sm text-zinc-400 leading-relaxed">@currentInsight.Message</p>

                                    @if (currentInsight.PotentialSavings > 0)
                                    {
                                        <span class="mt-auto w-full rounded-lg border border-white/10 bg-zinc-950/50 py-2 text-xs font-semibold text-zinc-300 shadow-inner">
                                            Potential recovery: <span class="@iconClasses">~@currentInsight.PotentialSavings.ToString("C")</span>
                                        </span>
                                    }
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- 6-Month Cash Flow Trend Chart -->
    <div class="mb-8 rounded-2xl border border-white/5 bg-zinc-900/50 shadow-2xl backdrop-blur-md">
        <div class="border-b border-white/5 px-6 py-4">
            <h5 class="text-lg font-bold text-white m-0">6-Month Cash Flow Trend</h5>
        </div>
        <div class="p-6">
            @if (!_cashFlowTrend.Any())
            {
                <p class="text-center text-zinc-500 py-8">Not enough data to display trend.</p>
            }
            else
            {
                <div class="flex items-end justify-around border-b border-zinc-800 pb-2 h-[220px]">
                    @foreach (var month in _cashFlowTrend)
                    {
                        var incomeHeight = _maxCashFlowAmount > 0 ? (month.Income / _maxCashFlowAmount) * 100 : 0;
                        var expenseHeight = _maxCashFlowAmount > 0 ? (month.Expense / _maxCashFlowAmount) * 100 : 0;

                        <div class="flex flex-col items-center justify-end h-full w-[14%] shrink">
                            <div class="flex w-full items-end justify-center gap-1.5 h-[180px]">
                                <!-- Income Bar -->
                                <div class="w-[40%] rounded-t bg-gradient-to-t from-emerald-600 to-emerald-400 chart-bar shadow-[0_0_15px_rgba(52,211,153,0.2)]"
                                     style="height: @(incomeHeight.ToString("0.##"))%;"
                                     title="Income: @month.Income.ToString("C")">
                                </div>
                                <!-- Expense Bar -->
                                <div class="w-[40%] rounded-t bg-gradient-to-t from-rose-600 to-rose-400 chart-bar shadow-[0_0_15px_rgba(251,113,133,0.2)]"
                                     style="height: @(expenseHeight.ToString("0.##"))%;"
                                     title="Expense: @month.Expense.ToString("C")">
                                </div>
                            </div>
                            <span class="mt-3 text-xs font-semibold text-zinc-500 uppercase tracking-wider">@month.MonthLabel</span>
                        </div>
                    }
                </div>

                <!-- Chart Legend -->
                <div class="mt-6 flex justify-center gap-8">
                    <div class="flex items-center gap-2">
                        <div class="h-3 w-3 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.5)]"></div>
                        <small class="font-semibold text-zinc-400">Income</small>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-3 w-3 rounded-full bg-rose-400 shadow-[0_0_8px_rgba(251,113,133,0.5)]"></div>
                        <small class="font-semibold text-zinc-400">Expense</small>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Weekly Snapshot & Achievements Row -->
    <div class="mb-8 grid gap-4 lg:grid-cols-2">

        <!-- Weekly Expenses -->
        <div class="flex flex-col rounded-2xl border border-white/5 bg-zinc-900/50 shadow-2xl backdrop-blur-md">
            <div class="border-b border-white/5 px-6 py-4">
                <h5 class="text-lg font-bold text-white m-0">Weekly Spend Pacing</h5>
            </div>
            <div class="flex-1 p-2">
                <div class="flex flex-col">
                    @foreach (var week in _weeklySpends.OrderBy(w => w.Key))
                    {
                        <a href="/transactions?period=@_selectedPeriod&week=@week.Key&type=Expense"
                           class="group flex items-center justify-between rounded-xl px-4 py-3 text-decoration-none transition-colors hover:bg-white/5">
                            <span class="font-medium text-zinc-300 group-hover:text-cyan-400 transition-colors">
                                Week @week.Key
                                <small class="ml-2 text-zinc-600">(Days @((week.Key - 1) * 7 + 1)-@(Math.Min(week.Key * 7, DateTime.DaysInMonth(int.Parse(_selectedPeriod.Split('-')[0]), int.Parse(_selectedPeriod.Split('-')[1])))))</small>
                            </span>
                            <span class="rounded-full bg-zinc-800 px-3 py-1 text-xs font-semibold text-zinc-300 border border-white/5">
                                @week.Value.ToString("C")
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Gamification Badges -->
        <div class="flex flex-col rounded-2xl border border-white/5 bg-zinc-900/50 shadow-2xl backdrop-blur-md">
            <div class="border-b border-white/5 px-6 py-4">
                <h5 class="text-lg font-bold text-white m-0">Monthly Achievements</h5>
            </div>
            <div class="flex-1 p-6 flex flex-wrap content-start gap-3">
                @if (!_earnedBadges.Any())
                {
                    <p class="w-full text-center text-sm text-zinc-500 mt-4">Analyzing spending patterns to award badges...</p>
                }
                else
                {
                    @foreach (var badge in _earnedBadges)
                    {
                        <div class="flex min-w-[160px] flex-1 items-center gap-3 rounded-xl border p-3 @badge.CssClass">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-zinc-950/30 backdrop-blur-sm">
                                <i class="bi @badge.Icon text-xl"></i>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-bold tracking-wide text-white">@badge.Title</span>
                                <span class="text-xs opacity-80">@badge.Description</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Paced Budget Progress -->
    <div class="mb-8 rounded-2xl border border-white/5 bg-zinc-900/50 shadow-2xl backdrop-blur-md">
        <div class="flex items-center justify-between border-b border-white/5 px-6 py-4">
            <h5 class="text-lg font-bold text-white m-0">Budget Pacing</h5>
            <span class="rounded bg-white/10 px-2.5 py-1 text-xs font-semibold text-zinc-400 border border-white/5">Target Pace: @(_targetPacePercentage.ToString("P0"))</span>
        </div>
        <div class="p-6">
            @if (!_budgetTrackers.Any())
            {
                <p class="text-center text-zinc-500 py-4 m-0">No budgets configured for this month.</p>
            }
            else
            {
                <div class="grid gap-6 md:grid-cols-2">
                    @foreach (var budget in _budgetTrackers)
                    {
                        <a href="/transactions?period=@_selectedPeriod&category=@Uri.EscapeDataString(budget.Category)" class="group block text-decoration-none rounded-xl p-4 transition-colors hover:bg-white/5">
                            <div class="mb-2 flex items-end justify-between">
                                <strong class="text-zinc-200 group-hover:text-cyan-400 transition-colors">@budget.Category</strong>
                                <span class="text-sm">
                                    <span class="font-bold text-white">@budget.Spent.ToString("C")</span>
                                    <span class="text-zinc-500"> / @budget.Limit.ToString("C")</span>
                                </span>
                            </div>

                            <!-- FinTech Progress Bar -->
                            <div class="h-3 w-full overflow-hidden rounded-full bg-zinc-950 shadow-inner">
                                <div class="h-full rounded-full transition-all duration-500 @budget.StatusColor relative"
                                     style="width: @(Math.Min(budget.SpentPercentage * 100, 100).ToString("0.##"))%;">
                                    <div class="absolute inset-0 bg-white/20"></div>
                                </div>
                            </div>
                            <div class="mt-1 flex justify-end">
                                <span class="text-[10px] font-bold tracking-wider text-zinc-500">
                                    @(Math.Round(budget.SpentPercentage * 100))% SPENT
                                </span>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Expense Breakdown List -->
    <div class="rounded-2xl border border-white/5 bg-zinc-900/50 shadow-2xl backdrop-blur-md">
        <div class="border-b border-white/5 px-6 py-4">
            <h5 class="text-lg font-bold text-white m-0">Expense Breakdown</h5>
        </div>
        <div class="p-2">
            @if (!_categoryExpenses.Any())
            {
                <p class="text-center text-zinc-500 py-6 m-0">No expenses recorded for this period.</p>
            }
            else
            {
                <div class="flex flex-col">
                    @foreach (var category in _categoryExpenses)
                    {
                        <a href="/transactions?period=@_selectedPeriod&category=@Uri.EscapeDataString(category.Key)"
                           class="group flex items-center justify-between rounded-xl px-4 py-3 text-decoration-none transition-colors hover:bg-white/5">
                            <span class="font-medium text-zinc-300 group-hover:text-cyan-400 transition-colors">@category.Key</span>
                            <span class="rounded-full bg-zinc-800 px-3 py-1 text-xs font-bold tracking-wide text-zinc-300 border border-white/5 shadow-inner">
                                @category.Value.ToString("C")
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card-hover {
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:hover {
            transform: translateY(-2px);
        }

    .chart-bar {
        transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s, filter 0.2s;
    }

        .chart-bar:hover {
            opacity: 0.9;
            filter: brightness(1.2) contrast(1.1);
            cursor: pointer;
        }

    .insight-slide {
        animation: fadeInSlide 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @@keyframes fadeInSlide {
        from {
            opacity: 0;
            transform: translateX(20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
</style>

@code {
    private bool _isLoading = true;
    private decimal _monthlyIncome = 0;
    private decimal _monthlyExpenses = 0;
    private decimal _netCashFlow = 0;
    private Dictionary<string, decimal> _categoryExpenses = new();
    private decimal _remainingExpectedBills = 0;
    private decimal _paidFixedBills = 0;
    private decimal _safeToSpend = 0;

    private List<PeriodOption> _availablePeriods = new();
    private string _selectedPeriod = string.Empty;
    private string _selectedPeriodLabel = string.Empty;

    private decimal _targetPacePercentage = 0;
    private List<BudgetTracker> _budgetTrackers = new();

    private Dictionary<int, decimal> _weeklySpends = new();
    private List<Badge> _earnedBadges = new();

    private List<MonthlyCashFlow> _cashFlowTrend = new();
    private decimal _maxCashFlowAmount = 0;
    private List<FinancialInsight> _insights = new();
    private int _totalPoints = 0;

    private int _currentInsightIndex = 0;

    private class MonthlyCashFlow
    {
        public string MonthLabel { get; set; } = string.Empty;
        public decimal Income { get; set; }
        public decimal Expense { get; set; }
    }

    private class Badge
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string CssClass { get; set; } = string.Empty;
    }

    private class BudgetTracker
    {
        public string Category { get; set; } = string.Empty;
        public decimal Limit { get; set; }
        public decimal Spent { get; set; }
        public decimal SpentPercentage => Limit > 0 ? Spent / Limit : 0;
        public string StatusColor { get; set; } = "bg-emerald-400";
    }

    protected override async Task OnInitializedAsync()
    {
        // 1. Subscribe to cross-page state changes
        TxStateService.OnStateChanged += HandleStateChanged;

        // 2. Zero-millisecond load check
        if (TxStateService.IsLoaded)
        {
            await LoadAvailablePeriodsAsync();
            await LoadDashboardDataAsync();
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isLoading)
        {
            // If cache was empty, load data in the background
            await LoadAvailablePeriodsAsync();
            await LoadDashboardDataAsync();
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAvailablePeriodsAsync()
    {
        // Pull instantly from State Service instead of DB
        var transactions = await TxStateService.GetTransactionsAsync();

        var dates = transactions
                    .Select(t => new { t.Date.Year, t.Date.Month })
                    .Distinct()
                    .OrderByDescending(x => x.Year)
                    .ThenByDescending(x => x.Month)
                    .ToList();

        _availablePeriods = dates.Select(d => new PeriodOption
        {
            Value = $"{d.Year}-{d.Month:D2}",
            Label = new DateTime(d.Year, d.Month, 1).ToString("MMMM yyyy")
        }).ToList();

        if (_availablePeriods.Any())
        {
            _selectedPeriod = _availablePeriods.First().Value;
            _selectedPeriodLabel = _availablePeriods.First().Label;
        }
        else
        {
            var now = DateTime.Now;
            _selectedPeriod = $"{now.Year}-{now.Month:D2}";
            _selectedPeriodLabel = now.ToString("MMMM yyyy");
            _availablePeriods.Add(new PeriodOption { Value = _selectedPeriod, Label = _selectedPeriodLabel });
        }
    }

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        _selectedPeriod = e.Value?.ToString() ?? _selectedPeriod;
        var selectedOpt = _availablePeriods.FirstOrDefault(p => p.Value == _selectedPeriod);
        if (selectedOpt != null)
        {
            _selectedPeriodLabel = selectedOpt.Label;
        }
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        if (string.IsNullOrEmpty(_selectedPeriod)) return;

        var profile = await DbContext.GamificationProfiles.FirstOrDefaultAsync();
        if (profile != null)
        {
            _totalPoints = profile.TotalPoints;
        }

        var parts = _selectedPeriod.Split('-');
        int year = int.Parse(parts[0]);
        int month = int.Parse(parts[1]);

        var startOfMonth = new DateTime(year, month, 1);
        var endOfMonth = startOfMonth.AddMonths(1).AddDays(-1);

        // Instantly pull all transactions from memory
        var allTransactions = await TxStateService.GetTransactionsAsync();

        var periodTransactions = allTransactions
                    .Where(t => t.Date >= startOfMonth && t.Date <= endOfMonth && !t.IsSplit)
                    .ToList();

        _monthlyIncome = periodTransactions
            .Where(t => t.Type == "Income")
            .Sum(t => t.Amount);

        _monthlyExpenses = periodTransactions
            .Where(t => t.Type == "Expense" && t.Type != "Transfer")
            .Sum(t => t.Amount);

        var fixedCategories = await DbContext.CategoryConfigs
            .Where(c => c.IsFixedBill)
            .Select(c => c.Name)
            .ToListAsync();

        var twoMonthsAgo = startOfMonth.AddMonths(-2);

        var historicalFixedTxns = allTransactions
                    .Where(t => t.Date >= twoMonthsAgo && t.Date < startOfMonth && t.Type == "Expense" && fixedCategories.Contains(t.Category ?? ""))
                    .GroupBy(t => new { t.Date.Year, t.Date.Month })
                    .Select(g => g.Sum(t => t.Amount))
                    .ToList();

        decimal expectedFixedTotal = historicalFixedTxns.Any() ? historicalFixedTxns.Average() : 0;

        _paidFixedBills = periodTransactions
            .Where(t => t.Type == "Expense" && fixedCategories.Contains(t.Category ?? ""))
            .Sum(t => t.Amount);

        _remainingExpectedBills = expectedFixedTotal - _paidFixedBills;

        if (_remainingExpectedBills < 0) _remainingExpectedBills = 0;

        _safeToSpend = _monthlyIncome - _monthlyExpenses - _remainingExpectedBills;
        _netCashFlow = _monthlyIncome - _monthlyExpenses;

        var sixMonthsAgo = startOfMonth.AddMonths(-5);

        var trendTransactions = allTransactions
                    .Where(t => t.Date >= sixMonthsAgo && t.Date <= endOfMonth && !t.IsSplit)
                    .ToList();

        _cashFlowTrend.Clear();

        for (int i = 5; i >= 0; i--)
        {
            var targetMonth = startOfMonth.AddMonths(-i);

            var monthTxns = trendTransactions
                            .Where(t => t.Date.Year == targetMonth.Year && t.Date.Month == targetMonth.Month)
                            .ToList();

            _cashFlowTrend.Add(new MonthlyCashFlow
            {
                MonthLabel = targetMonth.ToString("MMM"),
                Income = monthTxns.Where(t => t.Type == "Income").Sum(t => t.Amount),
                Expense = monthTxns.Where(t => t.Type == "Expense" && t.Type != "Transfer").Sum(t => t.Amount)
            });
        }

        _maxCashFlowAmount = _cashFlowTrend.Any()
            ? _cashFlowTrend.Max(c => Math.Max(c.Income, c.Expense))
            : 0;

        if (_maxCashFlowAmount == 0) _maxCashFlowAmount = 1;

        _categoryExpenses = periodTransactions
                    .Where(t => t.Type == "Expense" && t.Type != "Transfer")
                    .GroupBy(t => string.IsNullOrWhiteSpace(t.Category) ? "Uncategorized" : t.Category)
                    .OrderByDescending(g => g.Sum(t => t.Amount))
                    .ToDictionary(g => g.Key, g => g.Sum(t => t.Amount));

        var allBudgets = await DbContext.Budgets
            .Where(b => b.Period == _selectedPeriod)
            .ToListAsync();

        int daysInMonth = DateTime.DaysInMonth(year, month);
        var now = DateTime.Now;

        if (year == now.Year && month == now.Month)
        {
            _targetPacePercentage = (decimal)now.Day / daysInMonth;
        }
        else if (startOfMonth < now)
        {
            _targetPacePercentage = 1.0m;
        }
        else
        {
            _targetPacePercentage = 0.0m;
        }

        _budgetTrackers.Clear();
        foreach (var budget in allBudgets)
        {
            decimal spent = _categoryExpenses.ContainsKey(budget.Category)
                ? _categoryExpenses[budget.Category]
                : 0m;

            decimal percentSpent = budget.MonthlyLimit > 0 ? spent / budget.MonthlyLimit : 0;
            string color = "bg-emerald-400";

            if (percentSpent > 1.0m)
            {
                color = "bg-rose-500 shadow-[0_0_10px_rgba(244,63,94,0.5)]";
            }
            else if (percentSpent > _targetPacePercentage + 0.10m)
            {
                color = "bg-yellow-400 shadow-[0_0_10px_rgba(250,204,21,0.5)]";
            }

            _budgetTrackers.Add(new BudgetTracker
            {
                Category = budget.Category,
                Limit = budget.MonthlyLimit,
                Spent = spent,
                StatusColor = color
            });
        }

        _budgetTrackers = _budgetTrackers.OrderByDescending(b => b.SpentPercentage).ToList();

        var fixedBillCategories = fixedCategories.ToHashSet();

        var discretionaryExpenses = periodTransactions
            .Where(t => t.Type == "Expense"
                     && t.Type != "Transfer"
                     && !fixedBillCategories.Contains(t.Category ?? "Uncategorized"))
            .ToList();

        _weeklySpends = discretionaryExpenses
            .GroupBy(t => (t.Date.Day - 1) / 7 + 1)
            .ToDictionary(g => g.Key, g => g.Sum(t => t.Amount));

        int totalWeeks = (int)Math.Ceiling(daysInMonth / 7.0);
        for (int i = 1; i <= totalWeeks; i++)
        {
            if (!_weeklySpends.ContainsKey(i)) _weeklySpends[i] = 0m;
        }

        _earnedBadges.Clear();

        if (_netCashFlow > 0 && _monthlyExpenses > 0)
        {
            _earnedBadges.Add(new Badge
            {
                Title = "In the Green",
                Description = "Positive cash flow this month",
                Icon = "bi-graph-up-arrow text-emerald-400",
                CssClass = "bg-emerald-500/10 border-emerald-500/30 text-emerald-100 shadow-[0_0_15px_rgba(52,211,153,0.1)]"
            });
        }

        bool allBudgetsOnTrack = _budgetTrackers.Any() && _budgetTrackers.All(b => b.StatusColor == "bg-emerald-400");
        if (allBudgetsOnTrack)
        {
            _earnedBadges.Add(new Badge
            {
                Title = "Pacing Champion",
                Description = "100% of budgets are on track",
                Icon = "bi-trophy-fill text-yellow-400",
                CssClass = "bg-yellow-500/10 border-yellow-500/30 text-yellow-100 shadow-[0_0_15px_rgba(250,204,21,0.1)]"
            });
        }

        var daysWithExpenses = discretionaryExpenses
            .Select(t => t.Date.Day)
            .Distinct()
            .Count();

        int daysPassed = (year == now.Year && month == now.Month) ? now.Day : daysInMonth;
        int zeroSpendDays = daysPassed - daysWithExpenses;

        if (zeroSpendDays >= 5)
        {
            _earnedBadges.Add(new Badge
            {
                Title = "Frugal Master",
                Description = $"{zeroSpendDays} zero-spend days",
                Icon = "bi-shield-check text-cyan-400",
                CssClass = "bg-cyan-500/10 border-cyan-500/30 text-cyan-100 shadow-[0_0_15px_rgba(6,182,212,0.1)]"
            });
        }

        _insights = await InsightService.GenerateInsightsAsync(_selectedPeriod);
        _currentInsightIndex = 0;

        await GamificationEngine.EvaluateAchievementsAsync();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadAvailablePeriodsAsync();
            await LoadDashboardDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TxStateService.OnStateChanged -= HandleStateChanged;
    }

    private void NextInsight()
    {
        if (_insights.Any())
        {
            _currentInsightIndex = (_currentInsightIndex + 1) % _insights.Count;
        }
    }

    private void PreviousInsight()
    {
        if (_insights.Any())
        {
            _currentInsightIndex = (_currentInsightIndex - 1 + _insights.Count) % _insights.Count;
        }
    }

    private class PeriodOption
    {
        public string Value { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
    }
}